PSID=
PSIDTS=

# Optional: seconds to wait when connecting to Gemini
GEMINI_TIMEOUT=90

# Optional proxy: http://user:pass@host:port or socks5://host:port
GEMINI_PROXY=

# Keep-alive interval in seconds (default 1800 = 30 minutes)
SESSION_KEEPALIVE_SECONDS=1800

# Optional browser-cookie3 source (fallback after cache + .env)
# COOKIE_BROWSER: chrome | chromium | edge | brave | firefox | ...
COOKIE_BROWSER=chrome
# Profile name (Default, Profile 1) OR absolute path to a Cookies file / profile dir
COOKIE_BROWSER_PROFILE=Default
